# Downloaded open data, re-fetched on every run
cache/

# Everything under output/ is generated by twstock_screener.py.
#
# artifact.html used to be committed so the (now disabled) Claude cloud routine
# could publish it without reaching the exchanges. GitHub Pages serves
# output/index.html straight from the workflow instead, so nothing reads the
# committed copy any more -- and because every run rewrites its timestamp, it
# conflicted with any local rebuild. To revive the routine, commit it again
# here and in the workflow's commit step.
output/

__pycache__/
*.pyc
